# .coveragerc —— 总体覆盖率门的排除规则
#
# 只被 CI 的 Gate 2/2（--cov-fail-under=92）使用，通过 COVERAGE_RCFILE 指向本文件。
# Gate 1/2（核心层 ≥98%）用显式 --cov=guild_auto.<层> 指定模块，不读本文件，
# 因此核心层不会被这里的排除规则意外削弱。
#
# 为什么需要它：pytest-cov 没有 --cov-omit 参数，exclude 只能配在这里。

[run]
branch = True
# src-layout:只统计已安装的 guild_auto 包。
# 原来写 source = . 会把 tests/ 与仓库根杂项一起卷进分母;现在包名由
# pyproject.toml 的 [tool.coverage.run] 与本文件共同限定在 guild_auto 内。
source =
    guild_auto

[report]
# 与 CI 门禁同口径：只统计本项目自己的代码
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
