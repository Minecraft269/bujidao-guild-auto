{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "布吉岛公会管理脚本-Gui",
  "version": "0.1.0",
  "identifier": "com.bujidao.guild.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "布吉岛公会管理脚本 · Gui",
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "label": "main",
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
