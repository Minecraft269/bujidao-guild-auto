# ── Python 字节码 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── 构建产物(PyInstaller)─────────────────────────────────────
build/
dist/
*.spec
# 打包期能力常量(scripts/build-variants.py 生成):提交进来会让本地源码运行
# 悄悄锁定成某一个变体的能力清单,而不是"源码运行=全能力"。
src/guild_auto/_build_capabilities.py

# ── 运行期产物(日志 / 报告 / 用户配置)────────────────────────
logs/
reports/
config.json
*.log

# ── 打包元数据(pip install -e . 产生)──────────────────────────
*.egg-info/
*.egg

# ── 虚拟环境 ─────────────────────────────────────────────────
.venv/
venv/
env/

# ── 测试与覆盖率 ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mutmut-cache/

# ── IDE / 系统 ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
